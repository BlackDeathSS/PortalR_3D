o two_cell_chamber

# Outer chamber corners.
v 0 -4 0
v 16 -4 0
v 16 4 0
v 0 4 0
v 0 -4 4
v 16 -4 4
v 16 4 4
v 0 4 4

# Divider south of the gateway.
v 8 -4 0
v 8 -2 0
v 8 -2 4
v 8 -4 4

# Divider north of the gateway.
v 8 2 0
v 8 4 0
v 8 4 4
v 8 2 4

# Divider lintel above the gateway.
v 8 -2 3
v 8 2 3
v 8 2 4
v 8 -2 4

# Wall atlas quadrant (top-left after OBJ V conversion).
vt 0.02 0.98
vt 0.48 0.98
vt 0.48 0.52
vt 0.02 0.52
# Floor atlas quadrant (top-right).
vt 0.52 0.98
vt 0.98 0.98
vt 0.98 0.52
vt 0.52 0.52
# Ceiling atlas quadrant (bottom-left).
vt 0.02 0.48
vt 0.48 0.48
vt 0.48 0.02
vt 0.02 0.02
# Divider atlas quadrant (bottom-right).
vt 0.52 0.48
vt 0.98 0.48
vt 0.98 0.02
vt 0.52 0.02

# All outer faces wind inward so the runtime backface test sees the room.
usemtl floor
f 1/5 2/6 3/7 4/8
usemtl ceiling
f 8/9 7/10 6/11 5/12
usemtl wall
f 4/1 3/2 7/3 8/4
f 2/1 1/2 5/3 6/4
f 1/1 4/2 8/3 5/4
f 3/1 2/2 6/3 7/4

# The internal wall is explicitly two-sided around the gateway opening.
usemtl divider
f 10/13 9/14 12/15 11/16
f 9/13 10/14 11/15 12/16
f 14/13 13/14 16/15 15/16
f 13/13 14/14 15/15 16/16
f 18/13 17/14 20/15 19/16
f 17/13 18/14 19/15 20/16
